# Rust
/target/
**/target/
# Cargo.lock IS committed: this is a binary project and the lockfile is part
# of the reproducible build.

# Verification output
/out/
/out-*/
/verification/out/
/verification/data/
/verification/adversarial/
*.out

# The measurement ledger IS committed: it is the evidence behind every
# number in the per-track PERF.md files. A table the judges read has to
# have a machine-produced provenance, and that provenance is this file.
!verification/ledger.jsonl
/verification/tmp/

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# Bench artifacts
perf.data
perf.data.old
flamegraph.svg
*.profraw
*.profdata

# Sample data (never commit real datasets)
/data/
sample-data/

# Toolchain vendor cache (regenerated offline)
vendor/

# Build outputs and test scratch
/bin/
/verification/data2/
/verification/tmp2/

# Python bytecode: build residue, and a stale .pyc will shadow a real source change
__pycache__/
*.pyc
*.pyo

# Per-track local build artifacts: each track's build.sh emits ./run (and on
# Windows a .pdb). These are host-built binaries of unknown provenance and must
# never enter the submission repo or the Docker build context.
track-*/run
track-*/run.exe
track-*/run.pdb


# The organizers' generators checkout (fetched by tooling/gen-official-data.sh)
.official-generators/


# transient commit-message files
.commitmsg.txt

.cm.txt

