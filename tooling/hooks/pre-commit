#!/bin/sh
# Pre-commit gate for the Speed Demon campaign.
#
# A gate failure on the scoring box means ZERO on that track, and the
# organizers publish which gate you failed. This hook makes the most common
# failure — a broken output hash — impossible to commit in the first place.
#
# What it does:
#   0. rule 05 compliance (pre-kickoff only): refuse a commit that
#      contains track-solution code before the 72-hour window opens
#   1. rustfmt check (the S axis is measured on formatted source, so an
#      unformatted tree is an inaccurately measured tree)
#   2. clippy with warnings denied
#   3. offline build
#   4. for every TRACK whose source changed: run the binary and compare the
#      output SHA-256 against the pinned expected hash, if one is pinned.
#      Without a pinned hash (the Oct 30 sample has not shipped yet) it
#      checks determinism instead: 3 runs, byte-identical.
#
# Install with:  sh tooling/install-hooks.sh
set -eu

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

fail() {
    echo "" >&2
    echo "PRE-COMMIT BLOCKED: $1" >&2
    echo "" >&2
    exit 1
}

# ---- 0. rule 05 compliance -------------------------------------------------
# Before kickoff, this is the most important check in the file: a commit
# containing a track solution can disqualify the whole submission.
PY="$(command -v python3 2>/dev/null || command -v python 2>/dev/null || true)"
if [ -n "$PY" ]; then
    if ! "$PY" tooling/rule05_guard.py >/tmp/sd-rule05.log 2>&1; then
        cat /tmp/sd-rule05.log >&2
        fail "rule 05 guard blocked this commit"
    fi
fi

# ---- 1. formatting --------------------------------------------------------
HMANIFEST="verification/harness/Cargo.toml"
if command -v cargo >/dev/null 2>&1; then
    if ! cargo fmt --manifest-path "$HMANIFEST" -- --check 2>/dev/null; then
        echo "  formatting drift — run: cargo fmt --manifest-path $HMANIFEST" >&2
        fail "rustfmt check failed"
    fi

    # the prep kit is copy-in material: it must stay formatted too
    if [ -d prep ] && command -v rustfmt >/dev/null 2>&1; then
        if ! rustfmt --edition 2021 --check prep/*.rs 2>/dev/null; then
            echo "  formatting drift in prep/ — run: rustfmt --edition 2021 prep/*.rs" >&2
            fail "rustfmt check failed (prep)"
        fi
    fi

    # ---- 2. clippy --------------------------------------------------------
    if ! cargo clippy --manifest-path "$HMANIFEST" --all-targets --offline -- -D warnings 2>/dev/null; then
        echo "  clippy warnings are errors here — fix them or justify them" >&2
        fail "clippy failed"
    fi

    # ---- 3. offline build -------------------------------------------------
    if ! cargo build --release --offline --manifest-path "$HMANIFEST" 2>/dev/null; then
        fail "offline release build failed"
    fi
fi

# ---- 4. per-track gate ----------------------------------------------------
# The Rust harness is preferred: it is the same implementation that runs on
# the scoring box, where PowerShell does not exist.
HARNESS="verification/harness/target/release/sd-harness"
if [ ! -x "$HARNESS" ] && [ -x "$HARNESS.exe" ]; then
    HARNESS="$HARNESS.exe"
fi
STAGED="$(git diff --cached --name-only | grep -E '^track-[A-D]/' | cut -d/ -f2 | sed 's/^track-//' | sort -u || true)"
if [ -n "$STAGED" ] && [ "$(uname -s 2>/dev/null)" != "Linux" ]; then
    echo "  (per-track gate skipped: this host builds Windows PE binaries;"
    echo "   the e2e suite + ci.sh cover determinism/SHA here)"
    STAGED=""
fi
for T in $STAGED; do
    case "$T" in
        A|B|C|D) ;;
        *) continue ;;
    esac
    echo "  running the gate for track $T"
    RAN=0
    if [ -x "$HARNESS" ]; then
        BIN="$ROOT/track-$T/run"
        if [ ! -x "$BIN" ]; then
            BIN="$ROOT/track-$T/run.exe"
        fi
        if "$HARNESS" verify --track "$T" --no-docker --bin "$BIN" >/tmp/sd-gate-$T.log 2>&1; then
            RAN=1
        else
            cat /tmp/sd-gate-$T.log >&2
            fail "track $T did not pass the gate"
        fi
    elif command -v pwsh >/dev/null 2>&1; then
        if pwsh -NoProfile -File verification/verify.ps1 -Track "$T" >/tmp/sd-gate-$T.log 2>&1; then
            RAN=1
        else
            cat /tmp/sd-gate-$T.log >&2
            fail "track $T did not pass the gate"
        fi
    fi
    if [ "$RAN" = "1" ]; then
        # Surface warnings (e.g. an unpinned expected hash) without failing.
        grep -E '\[WARN\]|UNVERIFIABLE' /tmp/sd-gate-$T.log || true
    fi
done

exit 0
